<?xml version="1.0" encoding="utf-8"?>
<!-- debug 专属组件（release 不合并）：xipm dev 的插件热安装通道 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 主通道：adb shell am start 触发（shell 特权，不受后台执行限制） -->
        <activity
            android:name=".plugin.DebugPluginInstallActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 兼容通道：前台时可用的广播接收器 -->
        <receiver
            android:name=".plugin.DebugPluginInstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kingzcheung.xime.action.DEBUG_INSTALL_PLUGIN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>